{
  "name": "marketpulse",
  "version": "1.0.0",
  "description": "MarketPulse is a platform that collects, standardizes and analyzes fresh produce market prices from South African fresh produce markets.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "typecheck": "tsc",
    "scrape:tshwane": "tsx scrapers/markets/tshwane.ts",
    "process:tshwane": "tsx scrapers/engine/processor.ts",
    "import:tshwane": "tsx scrapers/engine/supabase-importer.ts",
    "test": "playwright test",
    "pipeline:tshwane": "tsx scrapers/engine/tshwane-pipeline.ts",
    "pipeline:tshwane:commit": "tsx scrapers/engine/tshwane-pipeline.ts --commit",
    "pipeline:tshwane:dry-run-existing": "tsx scrapers/engine/tshwane-pipeline.ts --skip-scrape"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparkstudioagency-cmd/marketpulse.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sparkstudioagency-cmd/marketpulse/issues"
  },
  "homepage": "https://github.com/sparkstudioagency-cmd/marketpulse#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "supabase": "^2.109.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
