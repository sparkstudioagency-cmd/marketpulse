{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "scrapers/**/*.ts",
    "scripts/**/*.ts",
    "weather/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "scrapers/markets/tshwane-prototype.ts",
    "processed-output",
    "scraper-output",
    "scraper-diagnostics",
    "playwright-report",
    "test-results",
    "dist",
    "build",
    "coverage"
  ]
}
